{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WSABuildsAnalyticsMetrics",
  "type": "object",
  "required": [
    "schema_version",
    "last_updated",
    "transparency_principles",
    "release_metrics",
    "compatibility_metrics",
    "root_flavor_distribution",
    "architecture_distribution",
    "version_adoption"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "last_updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}"
    },
    "transparency_principles": {
      "type": "object",
      "required": [
        "zero_pii",
        "no_ip_logging",
        "no_cookies",
        "public_aggregates_only"
      ],
      "additionalProperties": false,
      "properties": {
        "zero_pii": { "type": "boolean", "const": true },
        "no_ip_logging": { "type": "boolean", "const": true },
        "no_cookies": { "type": "boolean", "const": true },
        "public_aggregates_only": { "type": "boolean", "const": true }
      }
    },
    "release_metrics": {
      "type": "object",
      "required": [
        "total_releases",
        "total_downloads_aggregate",
        "latest_version",
        "active_packages_count"
      ],
      "additionalProperties": false,
      "properties": {
        "total_releases": { "type": "integer", "minimum": 0 },
        "total_downloads_aggregate": { "type": "integer", "minimum": 0 },
        "latest_version": { "type": "string" },
        "active_packages_count": { "type": "integer", "minimum": 0 }
      }
    },
    "compatibility_metrics": {
      "type": "object",
      "required": [
        "total_apps_tested",
        "compatible_count",
        "working_with_issues_count",
        "unsupported_count",
        "play_integrity_required_count",
        "categories_count"
      ],
      "additionalProperties": false,
      "properties": {
        "total_apps_tested": { "type": "integer", "minimum": 0 },
        "compatible_count": { "type": "integer", "minimum": 0 },
        "working_with_issues_count": { "type": "integer", "minimum": 0 },
        "unsupported_count": { "type": "integer", "minimum": 0 },
        "play_integrity_required_count": { "type": "integer", "minimum": 0 },
        "categories_count": { "type": "integer", "minimum": 0 }
      }
    },
    "root_flavor_distribution": {
      "type": "object",
      "required": ["magisk", "kernelsu", "none"],
      "additionalProperties": false,
      "properties": {
        "magisk": { "type": "integer", "minimum": 0 },
        "kernelsu": { "type": "integer", "minimum": 0 },
        "none": { "type": "integer", "minimum": 0 }
      }
    },
    "architecture_distribution": {
      "type": "object",
      "required": ["x64", "arm64"],
      "additionalProperties": false,
      "properties": {
        "x64": { "type": "integer", "minimum": 0 },
        "arm64": { "type": "integer", "minimum": 0 }
      }
    },
    "version_adoption": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version",
          "label",
          "adoption_percentage",
          "release_date"
        ],
        "additionalProperties": false,
        "properties": {
          "version": { "type": "string" },
          "label": { "type": "string" },
          "adoption_percentage": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "release_date": { "type": "string" }
        }
      }
    }
  }
}
