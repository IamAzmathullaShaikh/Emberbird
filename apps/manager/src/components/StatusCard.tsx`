import React, { useState } from 'react';
import { projectSubsystemStatus } from '../lib/state';
import { installWsaPackage, launchWsa, shutdownWsa } from '../lib/ipc';
import type { WsaStatus, InstallResult } from '../lib/types';

interface StatusCardProps {
  status: WsaStatus | null;
  onRefresh?: () => void;
}

export const StatusCard: React.FC<StatusCardProps> = ({ status, onRefresh }) => {
  const [selectedEdition, setSelectedEdition] = useState<'standard' | 'banking'>('standard');
  const [packagePath, setPackagePath] = useState('C:\\\\Emberbird\\\\WSA_2407.40000.4.0_x64_Release-Magisk');
  const [isInstalling, setIsInstalling] = useState(false);
  const [actionBusy, setActionBusy] = useState(false);
  const [actionFeedback, setActionFeedback] = useState<string | null>(null);
  const [copiedCmd, setCopiedCmd] = useState(false);
  const [installResult, setInstallResult] = useState<InstallResult | null>(null);
  const [installError, setInstallError] = useState<string | null>(null);

  if (!status) {
    return (
      <div className=\"p-6 rounded-2xl bg-ember-charcoal/40 border border-ember-ash/20 animate-pulse\">
        <div className=\"h-4 bg-ember-ash/20 rounded w-1/4 mb-4\"></div>
        <div className=\"h-3 bg-ember-ash/10 rounded w-3/4\"></div>
      </div>
    );
  }

  const projected = projectSubsystemStatus(status);
  const { presentation } = projected;

  const handleSelectEdition = (edition: 'standard' | 'banking') => {
    setSelectedEdition(edition);
    if (edition === 'standard') {
      setPackagePath('C:\\\\Emberbird\\\\WSA_2407.40000.4.0_x64_Release-Magisk');
    } else {
      setPackagePath('C:\\\\Emberbird\\\\WSA_2407.40000.4.0_x64_Release-Vanilla');
    }
  };

  const handleLaunch = async (target?: string) => {
    setActionBusy(true);
    setActionFeedback(null);
    try {
      await launchWsa(target);
      setActionFeedback(`Launched ${target || 'Engine Settings'}`);
      if (onRefresh) onRefresh();
    } catch (err) {
      setActionFeedback(`Launch failed: ${String(err)}`);
    } finally {
      setActionBusy(false);
    }
  };

  const handleShutdown = async () => {
    setActionBusy(true);
    setActionFeedback(null);
    try {
      await shutdownWsa();
      setActionFeedback('Shutdown signal sent to Engine.');
      setTimeout(() => onRefresh && onRefresh(), 1500);
    } catch (err) {
      setActionFeedback(`Shutdown failed: ${String(err)}`);
    } finally {
      setActionBusy(false);
    }
  };

  const handleQuickInstall = async () => {
    if (!packagePath.trim()) {
      setInstallError('Please specify the path to your extracted Emberbird package directory.');
      return;
    }

    setIsInstalling(true);
    setInstallError(null);
    setInstallResult(null);

    try {
      const res = await installWsaPackage(packagePath.trim());
      setInstallResult(res);
      if (res.success && onRefresh) {
        onRefresh();
      }
    } catch (err) {
      setInstallError(`Installation error: ${String(err)}`);
    } finally {
      setIsInstalling(false);
    }
  };

  return (
    <div className=\"p-6 rounded-2xl bg-ember-charcoal/60 border border-ember-ash/20 shadow-xl backdrop-blur-sm space-y-6\">\n      <div className=\"flex items-center justify-between\">\n        <h2 className=\"text-xs font-bold uppercase tracking-widest text-ember-ash\">\n          Engine Status & Environment\n        </h2>\n        <div className=\"flex items-center gap-2\">\n          <span className={`w-2 h-2 rounded-full ${presentation.dotClass} shadow-[0_0_8px] shadow-current`} />\n          <span className={`px-2.5 py-1 rounded-full text-xs font-semibold ${presentation.badgeClass}`}>\n            {presentation.label}\n          </span>\n          <span className=\"text-xs font-mono text-ember-glow\">\n            {projected.versionLabel !== '—' ? projected.versionLabel : ''}\n          </span>\n        </div>\n      </div>\n\n      <div className={`p-4 rounded-xl text-xs border ${presentation.badgeClass} bg-opacity-20`}>\n        {presentation.guidance}\n        {status.state_evidence.length > 0 && (\n          <ul className=\"mt-2 space-y-1 text-[11px] opacity-70\">\n            {status.state_evidence.map((e, i) => (\n              <li key={i} className=\"flex items-center gap-1.5\">\n                <span className=\"text-ember-glow\">•</span> {e}\n              </li>\n            ))}\n          </ul>\n        )}\n      </div>\n\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs\">\n        <div className=\"p-4 rounded-xl bg-ember-obsidian/50 border border-ember-ash/20 hover:border-ember-ash/40 transition-colors\">\n          <div className=\"text-ember-ash font-medium mb-1\">Virtualization</div>\n          <div className=\"font-semibold text-sm flex items-center gap-2\">\n            <span className={`w-2 h-2 rounded-full ${status.virtualization_enabled ? 'bg-emerald-400 shadow-[0_0_8px_#34d399]' : 'bg-rose-500 shadow-[0_0_8px_#f43f5e]'}`}></span>\n            <span className={status.virtualization_enabled ? 'text-white' : 'text-rose-400'}>\n              {status.virtualization_enabled ? 'Active' : 'Disabled'}\n            </span>\n          </div>\n        </div>\n\n        <div className=\"p-4 rounded-xl bg-ember-obsidian/50 border border-ember-ash/20 hover:border-ember-ash/40 transition-colors\">\n          <div className=\"text-ember-ash font-medium mb-1\">Developer Policy</div>\n          <div className=\"mt-1 font-semibold text-sm flex items-center gap-2\">\n            <span className={`w-2 h-2 rounded-full ${status.developer_mode_enabled ? 'bg-emerald-400 shadow-[0_0_8px_#34d399]' : 'bg-amber-400 shadow-[0_0_8px_#fbbf24]'}`}></span>\n            <span className={status.developer_mode_enabled ? 'text-white' : 'text-amber-400'}>\n              {status.developer_mode_enabled ? 'Unlocked' : 'Locked'}\n            </span>\n          </div>\n        </div>\n      </div>\n\n      {status.install_path && (\n        <div className=\"p-3 rounded-xl bg-ember-obsidian/40 border border-ember-ash/20 text-xs\">\n          <span className=\"text-ember-ash block mb-1\">Engine Install Path:</span>\n          <code className=\"text-slate-300 font-mono text-[11px] select-all break-all\">{status.install_path}</code>\n        </div>\n      )}\n\n      {status.vhdx_path && (\n        <div className=\"p-3 rounded-xl bg-ember-obsidian/40 border border-ember-ash/20 text-xs\">\n          <span className=\"text-ember-ash block mb-1\">Data Vault Path{status.state === 'NOT_INSTALLED' ? ' (orphaned)' : ''}:</span>\n          <code className=\"text-slate-300 font-mono text-[11px] select-all break-all\">{status.vhdx_path}</code>\n        </div>\n      )}\n\n      {/* Subsystem Controls */}\n      {status.state !== 'NOT_INSTALLED' && status.state !== 'UNKNOWN' && (\n        <div className=\"mt-6 pt-5 border-t border-ember-ash/20 space-y-3\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-xs font-bold uppercase tracking-widest text-ember-ash\">Engine Controls</span>\n            {actionFeedback && (\n              <span className=\"text-[11px] text-ember-glow animate-pulse\">{actionFeedback}</span>\n            )}\n          </div>\n          <div className=\"flex flex-wrap items-center gap-3\">\n            <button\n              type=\"button\"\n              onClick={() => handleLaunch('wsa://settings')}\n              disabled={actionBusy}\n              className=\"px-4 py-2 rounded-lg bg-ember-charcoal hover:bg-ember-ash/40 border border-ember-ash/30 text-white text-xs font-semibold transition-all flex items-center gap-2 hover:scale-[1.02] active:scale-95\"\n            >\n              <span>⚙️</span> Control Panel\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => handleLaunch('wsa://com.android.vending')}\n              disabled={actionBusy}\n              className=\"px-4 py-2 rounded-lg bg-ember-glow hover:bg-ember-highlight text-ember-obsidian text-xs font-bold shadow-lg shadow-ember-glow/20 transition-all flex items-center gap-2 hover:scale-[1.02] active:scale-95\"\n            >\n              <span>🛍️</span> Play Store\n            </button>\n            <button\n              type=\"button\"\n              onClick={handleShutdown}\n              disabled={actionBusy}\n              className=\"px-4 py-2 rounded-lg bg-ember-obsidian hover:bg-ember-charcoal text-ember-ash text-xs font-medium border border-ember-ash/20 transition-all flex items-center gap-2 hover:scale-[1.02] active:scale-95\"\n            >\n              <span>⏹️</span> Shutdown\n            </button>\n          </div>\n        </div>\n      )}\n\n      {/* Quick Install Wizard */}\n      {status.state === 'NOT_INSTALLED' && (\n        <div className=\"mt-6 pt-5 border-t border-ember-ash/20 space-y-4\">\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center gap-2\">\n              <span className=\"w-2 h-2 rounded-full bg-ember-glow animate-ping\"></span>\n              <h3 className=\"text-sm font-bold text-white\">Quick Deployment Wizard</h3>\n            </div>\n            <span className=\"text-[10px] font-mono px-2 py-0.5 rounded bg-ember-glow/10 text-ember-glow border border-ember-glow/20\">\n              Recommended\n            </span>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n            <button\n              type=\"button\"\n              onClick={() => handleSelectEdition('standard')}\n              className={`p-4 rounded-xl text-left transition-all border ${\n                selectedEdition === 'standard'\n                  ? 'bg-ember-glow/10 border-ember-glow text-white shadow-lg shadow-ember-glow/10'\n                  : 'bg-ember-obsidian/50 border-ember-ash/20 text-ember-ash hover:border-ember-ash/40'\n              }`}\n            >\n              <div className=\"flex items-center justify-between mb-1\">\n                <span className=\"font-bold text-xs text-ember-glow\">Standard Edition</span>\n                <span className=\"text-[10px] px-1.5 py-0.5 rounded bg-ember-glow/20 text-ember-glow\">Rooted</span>\n              </div>\n              <p className=\"text-[11px] text-ember-ash leading-snug\">\n                Magisk + GApps. Ideal for power users and modding.\n              </p>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => handleSelectEdition('banking')}\n              className={`p-4 rounded-xl text-left transition-all border ${\n                selectedEdition === 'banking'\n                  ? 'bg-emerald-500/10 border-emerald-500 text-white shadow-lg shadow-emerald-500/10'\n                  : 'bg-ember-obsidian/50 border-ember-ash/20 text-ember-ash hover:border-ember-ash/40'\n              }`}\n            >\n              <div className=\"flex items-center justify-between mb-1\">\n                <span className=\"font-bold text-xs text-emerald-400\">Banking Edition</span>\n                <span className=\"text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-400\">Vanilla</span>\n              </div>\n              <p className=\"text-[11px] text-ember-ash leading-snug\">\n                Pure unrooted system. Native Play Integrity support.\n              </p>\n            </button>\n          </div>\n\n          <div className=\"p-4 rounded-xl bg-ember-obsidian/60 border border-ember-ash/20 space-y-3\">\n            <div className=\"space-y-1\">\n              <label className=\"block text-[11px] font-medium text-ember-ash\">Deployment Path:</label>\n              <input\n                type=\"text\"\n                value={packagePath}\n                onChange={(e) => setPackagePath(e.target.value)}\n                placeholder=\"C:\\\\Emberbird\\\\WSA_Package\"\n                className=\"w-full px-3 py-2 bg-ember-obsidian border border-ember-ash/30 rounded-lg text-xs font-mono text-white placeholder-ember-ash/50 focus:outline-none focus:border-ember-glow transition-colors\"\n              />\n            </div>\n\n            <div className=\"flex items-center justify-between gap-3 pt-1\">\n              <div className=\"text-[11px] text-ember-ash\">\n                {!status.virtualization_enabled ? (\n                  <span className=\"text-rose-400 font-medium\">⚠️ BIOS Virtualization Required</span>\n                ) : !status.developer_mode_enabled ? (\n                  <span className=\"text-amber-400 font-medium\">⚠️ Windows DevMode Required</span>\n                ) : (\n                  <span className=\"text-emerald-400\">✓ System Ready</span>\n                )}\n              </div>\n\n              <button\n                type=\"button\"\n                onClick={handleQuickInstall}\n                disabled={isInstalling || !status.developer_mode_enabled}\n                className=\"px-4 py-2 rounded-lg bg-ember-glow hover:bg-ember-highlight disabled:opacity-50 text-ember-obsidian text-xs font-bold shadow-lg shadow-ember-glow/30 transition-all whitespace-nowrap\"\n              >\n                {isInstalling ? 'Deploying...' : 'Deploy Engine'}\n              </button>\n            </div>\n          </div>\n\n          {installResult && (\n            <div\n              className={`p-3 rounded-lg text-xs border ${\n                installResult.success\n                  ? 'bg-emerald-500/10 text-emerald-300 border-emerald-500/30'\n                  : 'bg-rose-500/10 text-rose-300 border-rose-500/30'\n              }`}\n            >\n              {installResult.message}\n            </div>\n          )}\\n\n          {installError && (\n            <div className=\"p-4 rounded-xl bg-rose-950/40 text-rose-300 border border-rose-500/30 text-xs space-y-2\">\n              <div className=\"font-bold flex items-center gap-2 text-rose-200\">\n                <span>🛡️</span> Administrator Privileges Required\n              </div>\n              <p className=\"text-[11px] text-rose-300/90 leading-relaxed\">\n                Windows requires admin rights to register the system service. Run as Admin or use this command:\n              </p>\n              <div className=\"p-2 rounded bg-ember-obsidian/80 border border-ember-ash/30 font-mono text-[11px] text-slate-200 flex items-center justify-between gap-2 break-all\">\n                <code>Add-AppxPackage -Register \"{packagePath}\" -ForceApplicationShutdown -ForceUpdateFromAnyVersion</code>\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    navigator.clipboard.writeText(`Add-AppxPackage -Register \"${packagePath}\" -ForceApplicationShutdown -ForceUpdateFromAnyVersion`);\n                    setCopiedCmd(true);\n                    setTimeout(() => setCopiedCmd(false), 2000);\n                  }}\n                  className=\"px-2 py-1 rounded bg-ember-charcoal hover:bg-ember-ash/40 text-ember-glow text-[10px] font-sans whitespace-nowrap\"\n                >\n                  {copiedCmd ? 'Copied!' : 'Copy'}\n                </button>\n              </div>\n              <p className=\"text-[10px] text-rose-400 font-mono opacity-80\">{installError}</p>\n            </div>\n          )}\n        </div>\n      )}\n    </div>\n  );\n};