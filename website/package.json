{
  "name": "wsabuilds-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "import-docs": "node scripts/import-docs.mjs",
    "import-compat": "node scripts/import-compatibility.mjs",
    "import-analytics": "node scripts/import-analytics.mjs",
    "prebuild": "node scripts/import-docs.mjs && node scripts/import-compatibility.mjs && node scripts/import-analytics.mjs",
    "typecheck": "astro sync && tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "astro": "^7.3.3",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "autoprefixer": "^10.4.20",
    "pagefind": "^1.3.0",
    "typescript": "^5.8.2"
  }
}
