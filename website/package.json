{
  "name": "wsabuilds-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "import-docs": "node scripts/import-docs.mjs",
    "import-compat": "node scripts/import-compatibility.mjs",
    "prebuild": "node scripts/import-docs.mjs && node scripts/import-compatibility.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/tailwind": "^5.1.5",
    "astro": "^5.4.2",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "pagefind": "^1.3.0"
  }
}
