---
// SearchModal.astro - Pagefind Static Search Integration
---

<div id="search-modal" class="fixed inset-0 z-50 hidden bg-slate-950/80 backdrop-blur-sm flex items-start justify-center pt-20 px-4">
  <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-2xl overflow-hidden shadow-2xl">
    <div class="p-4 border-b border-slate-800 flex items-center gap-3">
      <input
        type="search"
        id="search-input"
        placeholder="Search documentation, error codes, and guides... (Ctrl+K)"
        class="w-full bg-transparent text-white placeholder-slate-500 focus:outline-none text-base"
      />
      <button id="search-close" class="text-xs uppercase tracking-wider text-slate-500 hover:text-white px-2 py-1">
        Esc
      </button>
    </div>
    <div id="search-results" class="max-h-96 overflow-y-auto p-4 space-y-2 text-sm text-slate-300">
      <div class="text-xs text-slate-500 text-center py-6">
        Type a query to search WSABuilds documentation.
      </div>
    </div>
  </div>
</div>

<script>
  let pagefindLoaded = false;
  let pagefindInstance: any = null;

  async function loadPagefind() {
    if (pagefindLoaded) return;
    try {
      // Lazy load Pagefind from static dist directory. Specifier is computed
      // so Rollup cannot statically resolve it (pagefind.js only exists in
      // dist after `pagefind --site dist` runs post-build).
      const spec = ['/pagefind/pagefind.js'].join('');
      const pagefind = await import(/* @vite-ignore */ spec);
      await pagefind.init();
      pagefindInstance = pagefind;
      pagefindLoaded = true;
    } catch (e) {
      console.warn('Pagefind index not found. Run "npx pagefind --site dist" after build.');
    }
  }

  const modal = document.getElementById('search-modal');
  const input = document.getElementById('search-input') as HTMLInputElement;
  const resultsContainer = document.getElementById('search-results');

  function openSearch() {
    modal?.classList.remove('hidden');
    input?.focus();
    loadPagefind();
  }

  function closeSearch() {
    modal?.classList.add('hidden');
  }

  window.addEventListener('open-search', openSearch);

  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
    if (e.key === 'Escape') {
      closeSearch();
    }
  });

  document.getElementById('search-close')?.addEventListener('click', closeSearch);

  input?.addEventListener('input', async (e) => {
    const query = (e.target as HTMLInputElement).value.trim();
    if (!query || !pagefindInstance || !resultsContainer) return;

    const search = await pagefindInstance.search(query);
    if (!search.results.length) {
      resultsContainer.innerHTML = '<div class="text-xs text-slate-500 text-center py-4">No results found.</div>';
      return;
    }

    const fiveResults = await Promise.all(search.results.slice(0, 5).map((r: any) => r.data()));
    resultsContainer.innerHTML = fiveResults.map((r: any) => `
      <a href="${r.url}" class="block p-3 rounded-lg hover:bg-slate-800/60 transition-colors">
        <div class="font-semibold text-white">${r.meta.title || r.url}</div>
        <div class="text-xs text-slate-400 mt-1">${r.excerpt}</div>
      </a>
    `).join('');
  });
</script>
