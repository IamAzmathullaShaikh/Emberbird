---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'WSABuilds - Windows Subsystem for Android Distribution',
  description = 'The easiest, most reliable, and community-supported way to run WSA on Windows 10 and 11.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-slate-950 text-slate-100 flex flex-col min-h-screen">
    <header class="border-b border-slate-800 bg-slate-900/60 backdrop-blur sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="text-xl font-bold tracking-tight text-white flex items-center gap-2">
          <span class="text-indigo-400">WSA</span>Builds
        </a>
        <nav class="flex items-center gap-6 text-sm font-medium text-slate-300">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <a href="/downloads" class="hover:text-white transition-colors">Downloads</a>
          <a href="/docs" class="hover:text-white transition-colors">Documentation</a>
          <a
            href="https://github.com/IamAzmathullaShaikh/WSABuilds"
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-400 hover:text-white transition-colors"
          >
            GitHub
          </a>
        </nav>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <footer class="border-t border-slate-800 bg-slate-900/40 mt-16 py-8">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-sm text-slate-500">
        <p>WSABuilds is a community open-source project. Not affiliated with Microsoft or Google.</p>
        <p class="mt-2">Licensed under Apache-2.0. Upstream tracking: MustardChef/WSABuilds.</p>
      </div>
    </footer>
  </body>
</html>
