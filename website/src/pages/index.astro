---
import Layout from '../layouts/Layout.astro';
---

<Layout title="WSABuilds - Run Android Apps on Windows 10 & 11">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-16">
    <div class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 mb-6">
        Community-Driven WSA Distribution
      </div>
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white leading-tight">
        Android on Windows, <span class="text-indigo-400">Simplified.</span>
      </h1>
      <p class="mt-6 text-lg text-slate-300 leading-relaxed">
        The easiest and most reliable way to install, update, and manage Windows Subsystem for Android after Microsoft deprecation. Pre-configured with Google Play Store and modern root solutions.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/downloads"
          class="px-8 py-3.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-semibold shadow-lg shadow-indigo-600/20 transition-colors"
        >
          Download Packages
        </a>
        <a
          href="/docs"
          class="px-8 py-3.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold border border-slate-700 transition-colors"
        >
          Quick Start Guide
        </a>
      </div>
    </div>

    <div class="mt-24 grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="p-6 rounded-xl bg-slate-900 border border-slate-800">
        <h3 class="text-lg font-bold text-white mb-2">Automated Upstream Sync</h3>
        <p class="text-sm text-slate-400 leading-relaxed">
          Continuously synchronizes and validates against upstream builds with automated CI quality gates and security audits.
        </p>
      </div>

      <div class="p-6 rounded-xl bg-slate-900 border border-slate-800">
        <h3 class="text-lg font-bold text-white mb-2">Google Play & Root Ready</h3>
        <p class="text-sm text-slate-400 leading-relaxed">
          Pre-integrated with MindTheGapps or OpenGApps, alongside Magisk and KernelSU options for full developer control.
        </p>
      </div>

      <div class="p-6 rounded-xl bg-slate-900 border border-slate-800">
        <h3 class="text-lg font-bold text-white mb-2">Play Integrity Compatibility</h3>
        <p class="text-sm text-slate-400 leading-relaxed">
          Comprehensive step-by-step documentation for banking and fintech apps including PhonePe, Paytm, and SBI YONO.
        </p>
      </div>
    </div>

    <div class="mt-16 p-6 rounded-xl bg-indigo-950/30 border border-indigo-800/40 text-center max-w-2xl mx-auto">
      <h4 class="text-sm font-semibold text-indigo-300 uppercase tracking-wider">Project Roadmap Notice</h4>
      <p class="mt-2 text-xs text-slate-400">
        Desktop GUI Manager, Compatibility Hub database, and Winget Distribution are in planned phases (Status: Planned Feature). Current web portal delivers direct package assets and documentation.
      </p>
    </div>
  </div>
</Layout>
