---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Emberbird - Run Android Apps on Windows 10 & 11">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-16">
    <div class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 mb-6">
        Registry-First Android on Windows Platform
      </div>
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white leading-tight">
        Android on Windows, <span class="text-indigo-400">Simplified.</span>
      </h1>
      <p class="mt-6 text-lg text-slate-300 leading-relaxed">
        The easiest and most reliable way to install, update, and manage Windows Subsystem for Android after Microsoft deprecation. Pre-configured with Google Play Store and verified dual-edition packaging.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/downloads"
          class="px-8 py-3.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-semibold shadow-lg shadow-indigo-600/20 transition-colors"
        >
          Download Packages
        </a>
        <a
          href="/docs"
          class="px-8 py-3.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold border border-slate-700 transition-colors"
        >
          Quick Start Guide
        </a>
      </div>
    </div>

    <!-- Ember Observatory Status Bar -->
    <div class="mt-14 max-w-4xl mx-auto p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-slate-900 via-indigo-950/40 to-slate-900 border border-indigo-500/30 shadow-xl">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500/20 text-indigo-400 border border-indigo-500/30 shrink-0">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xs font-bold text-white uppercase tracking-wider">Ember Observatory</span>
              <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Retail Active</span>
            </div>
            <p class="text-xs text-slate-400 mt-0.5">
              Recommended: <strong class="text-slate-200 font-mono">wsa-2311-standard</strong> &bull; Health: <strong class="text-emerald-400">100% Verified</strong> &bull; Compatibility: <strong class="text-indigo-300">96% Passed</strong>
            </p>
          </div>
        </div>
        <a
          href="/analytics"
          class="px-3.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-200 border border-slate-700 transition-colors whitespace-nowrap"
        >
          View Observatory &rarr;
        </a>
      </div>
    </div>

    <!-- Edition Selection in 30 Seconds -->
    <div class="mt-16 max-w-5xl mx-auto">
      <div class="text-center mb-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
          Choose Your Edition in 30 Seconds
        </h2>
        <p class="mt-2 text-sm text-slate-400">
          Tailored packages built for security compliance, financial apps, and developer customization.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Standard Edition Card -->
        <div class="p-6 rounded-2xl bg-slate-900/80 border border-indigo-500/30 hover:border-indigo-500/60 transition-all flex flex-col justify-between shadow-lg shadow-indigo-950/20">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
                Tier 1 &bull; Primary
              </span>
              <span class="text-xs font-mono text-slate-400">x64</span>
            </div>
            <h3 class="text-lg font-bold text-white mb-2">Standard Edition</h3>
            <p class="text-xs text-slate-300 leading-relaxed mb-4">
              Pre-rooted with official Magisk Stable (v30.6+) and OpenGApps Pico. Full root privilege management (UID 0) for developers, modders, and advanced tooling.
            </p>
            <ul class="text-xs text-slate-400 space-y-1.5 list-disc list-inside mb-4">
              <li>Magisk root daemon &amp; SU access</li>
              <li>Google Play Store &amp; Services (Pico)</li>
              <li>Pixel 5 Play Protect spoofing</li>
            </ul>
          </div>
          <a
            href="/downloads#standard"
            class="w-full text-center px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs transition-colors"
          >
            Get Standard Edition &rarr;
          </a>
        </div>

        <!-- Banking Edition Card -->
        <div class="p-6 rounded-2xl bg-slate-900/80 border border-emerald-500/30 hover:border-emerald-500/60 transition-all flex flex-col justify-between shadow-lg shadow-emerald-950/20">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                Tier 1 &bull; Security
              </span>
              <span class="text-xs font-mono text-slate-400">x64</span>
            </div>
            <h3 class="text-lg font-bold text-white mb-2">Banking Edition</h3>
            <p class="text-xs text-slate-300 leading-relaxed mb-4">
              100% clean unrooted ramdisk with OpenGApps Pico. Built for users running financial, banking (UPI/SBI/Paytm), and enterprise apps that enforce zero root detection.
            </p>
            <ul class="text-xs text-slate-400 space-y-1.5 list-disc list-inside mb-4">
              <li>Zero Magisk or su binary traces</li>
              <li>Google Play Store &amp; Services (Pico)</li>
              <li>Ideal for Banking, OTT &amp; Work MDM</li>
            </ul>
          </div>
          <a
            href="/downloads#banking"
            class="w-full text-center px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs transition-colors"
          >
            Get Banking Edition &rarr;
          </a>
        </div>

        <!-- ARM64 Edition Card -->
        <div class="p-6 rounded-2xl bg-slate-900/80 border border-cyan-500/30 hover:border-cyan-500/60 transition-all flex flex-col justify-between shadow-lg shadow-cyan-950/20">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">
                Copilot+ PC
              </span>
              <span class="text-xs font-mono text-slate-400">ARM64</span>
            </div>
            <h3 class="text-lg font-bold text-white mb-2">Snapdragon X Elite</h3>
            <p class="text-xs text-slate-300 leading-relaxed mb-4">
              Native ARM64 build workflow for Windows 11 on ARM and Qualcomm Snapdragon X Elite devices with hardware-accelerated instruction translation.
            </p>
            <ul class="text-xs text-slate-400 space-y-1.5 list-disc list-inside mb-4">
              <li>Native ARM64 execution pipeline</li>
              <li>Snapdragon X Elite compatibility</li>
              <li>Step-by-step local build guidance</li>
            </ul>
          </div>
          <a
            href="/arm64"
            class="w-full text-center px-4 py-2 rounded-lg bg-cyan-600 hover:bg-cyan-500 text-white font-semibold text-xs transition-colors"
          >
            View ARM64 Status &rarr;
          </a>
        </div>
      </div>
    </div>

    <!-- Quick Integrity & Diagnostic Assistance -->
    <div class="mt-14 max-w-4xl mx-auto grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div class="p-6 rounded-xl bg-slate-900/60 border border-slate-800">
        <h3 class="text-sm font-bold text-white flex items-center gap-2 mb-2">
          <span>&check;</span>
          <span>Verify Integrity in Under 1 Minute</span>
        </h3>
        <p class="text-xs text-slate-400 mb-3">
          Every release publishes cryptographic SHA-256 hashes. Verify your package before extracting:
        </p>
        <div class="p-2.5 rounded-lg bg-slate-950 border border-slate-800 font-mono text-[11px] text-indigo-300 select-all">
          Get-FileHash .\WSA_*.zip -Algorithm SHA256
        </div>
      </div>

      <div class="p-6 rounded-xl bg-slate-900/60 border border-slate-800">
        <h3 class="text-sm font-bold text-white flex items-center gap-2 mb-2">
          <span>&plusmn;</span>
          <span>Ember Doctor Diagnostic Centre</span>
        </h3>
        <p class="text-xs text-slate-400 mb-3">
          Run 12 diagnostic probes across Hyper-V, CPU virtualization, WSL, ADB, and storage corruption before installing:
        </p>
        <a
          href="/troubleshoot/doctor"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-indigo-400 hover:text-indigo-300"
        >
          <span>Run Ember Doctor Diagnostics</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>

    <!-- Features Overview -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="p-6 rounded-xl bg-slate-900 border border-slate-800">
        <h3 class="text-lg font-bold text-white mb-2">Registry-Driven Intelligence</h3>
        <p class="text-sm text-slate-400 leading-relaxed">
          Every release, asset, and checksum is validated against the frozen Ember Registry (releases.json) with automated integrity gates.
        </p>
      </div>

      <div class="p-6 rounded-xl bg-slate-900 border border-slate-800">
        <h3 class="text-lg font-bold text-white mb-2">Dual Tier-1 Editions</h3>
        <p class="text-sm text-slate-400 leading-relaxed">
          Choose Standard Edition with Magisk Stable (v30.6+) for root customization, or Banking Edition (Vanilla) for 100% clean app compatibility.
        </p>
      </div>

      <div class="p-6 rounded-xl bg-slate-900 border border-slate-800">
        <h3 class="text-lg font-bold text-white mb-2">Play Integrity Compatibility</h3>
        <p class="text-sm text-slate-400 leading-relaxed">
          Pixel 5 redfin device spoofing and verified community test records for banking, payment, and DRM streaming applications.
        </p>
      </div>
    </div>

    <div class="mt-16 p-6 rounded-xl bg-indigo-950/30 border border-indigo-800/40 text-center max-w-2xl mx-auto">
      <h4 class="text-sm font-semibold text-indigo-300 uppercase tracking-wider">Platform Status &amp; Roadmap</h4>
      <p class="mt-2 text-xs text-slate-400">
        Desktop Manager and Compatibility Hub are live. Release intelligence is driven 100% by the frozen Ember Registry (<code class="text-indigo-300">data/releases/releases.json</code>).
      </p>
    </div>
  </div>
</Layout>
