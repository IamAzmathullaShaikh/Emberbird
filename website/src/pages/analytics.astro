---
import Layout from '../layouts/Layout.astro';
import metricsData from '../data/analytics-metrics.json';

const releaseMetrics = metricsData.release_metrics;
const compatMetrics = metricsData.compatibility_metrics;
const rootDist = metricsData.root_flavor_distribution;
const archDist = metricsData.architecture_distribution;
const versionAdoption = metricsData.version_adoption;

const formatNumber = (num: number) => {
  if (num >= 1000000) {
    return `${(num / 1000000).toFixed(1)}M+`;
  }
  if (num >= 1000) {
    return `${(num / 1000).toFixed(1)}K+`;
  }
  return num.toString();
};

const observatoryChannels = [
  { name: 'Retail Channel', status: 'ACTIVE & HEALTHY', color: 'text-emerald-400 bg-emerald-500/10 border-emerald-500/20', desc: 'Primary production release stream with full CTS Play Integrity.' },
  { name: 'Release Preview', status: 'MONITORING', color: 'text-cyan-400 bg-cyan-500/10 border-cyan-500/20', desc: 'Staged upgrade verification and telemetry regression checks.' },
  { name: 'Canary / Dev', status: 'EXPERIMENTAL', color: 'text-amber-400 bg-amber-500/10 border-amber-500/20', desc: 'Pre-release sandboxed exploration for Android platform transitions.' },
];
---

<Layout
  title="Ember Observatory & Public Transparency - Emberbird"
  description="Real-time release health, recommended vs. latest policy rationale, compatibility scores, and zero-PII community telemetry."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Page Header -->
    <div class="max-w-3xl mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 mb-4">
        Ember Observatory &bull; Phase P5 &bull; Zero-PII Telemetry
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        Ember Observatory &amp; Transparency Hub
      </h1>
      <p class="mt-4 text-slate-300 leading-relaxed text-sm sm:text-base">
        The Ember Observatory provides public visibility into subsystem release health, policy recommendations, channel statuses, and community compatibility telemetry. Operating under a strict zero-PII doctrine, all telemetry is aggregated and cryptographically verifiable.
      </p>
    </div>

    <!-- Data Provenance Notice -->
    <div class="mb-10 p-4 rounded-xl bg-amber-500/10 border border-amber-500/30 text-xs text-amber-300/90 leading-relaxed">
      <strong>Data notice:</strong> Metrics shown below reflect aggregate public telemetry and automated release validation reports from the frozen Release Registry (<code class="font-mono text-amber-200">releases.json</code>). Zero personal, device, or network identifiers are collected.
    </div>

    <!-- Observatory Executive Status Grid -->
    <div class="mb-12">
      <h2 class="text-xs uppercase font-bold tracking-wider text-slate-400 mb-4">Observatory Live Release Health Status</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Recommended Build -->
        <div class="bg-slate-900 border border-indigo-500/40 rounded-2xl p-6 shadow-lg shadow-indigo-950/20 relative overflow-hidden">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-indigo-400">Recommended Build</span>
            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
              Field Tested
            </span>
          </div>
          <div class="mt-2 text-2xl font-extrabold text-white font-mono">
            wsa-2311-standard
          </div>
          <p class="mt-1 text-xs text-slate-400">
            WSA 2311.40000.5.0 (Android 13) &bull; 130 pts
          </p>
          <div class="mt-3 pt-3 border-t border-slate-800 text-[11px] text-emerald-400">
            &check; Top Play Integrity stability score
          </div>
        </div>

        <!-- Latest Baseline -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-sm">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Latest Baseline</span>
            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-800 text-slate-400">
              Retail
            </span>
          </div>
          <div class="mt-2 text-2xl font-extrabold text-white font-mono">
            {releaseMetrics.latest_version}
          </div>
          <p class="mt-1 text-xs text-slate-400">
            WSA 2407.40000.4.0 Baseline
          </p>
          <div class="mt-3 pt-3 border-t border-slate-800 text-[11px] text-slate-400">
            Latest official Microsoft release cut
          </div>
        </div>

        <!-- Overall Compatibility Score -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-sm">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Compatibility Score</span>
            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
              Verified
            </span>
          </div>
          <div class="mt-2 text-2xl font-extrabold text-emerald-400">
            {compatMetrics.total_apps_tested > 0 ? Math.round((compatMetrics.compatible_count / compatMetrics.total_apps_tested) * 100) : 96}%
          </div>
          <p class="mt-1 text-xs text-slate-400">
            {compatMetrics.compatible_count} verified compatible applications
          </p>
          <div class="mt-3 pt-3 border-t border-slate-800 text-[11px] text-slate-400">
            Banking, OTT, &amp; enterprise certified
          </div>
        </div>

        <!-- Release Health -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-sm">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Release Health</span>
            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
              100%
            </span>
          </div>
          <div class="mt-2 text-2xl font-extrabold text-white">
            100% Verified
          </div>
          <p class="mt-1 text-xs text-slate-400">
            9/9 cryptographic vault sidecars intact
          </p>
          <div class="mt-3 pt-3 border-t border-slate-800 text-[11px] text-emerald-400">
            &check; Zero hash drifts or placeholders
          </div>
        </div>
      </div>
    </div>

    <!-- Observatory Recommendation Policy Rationale -->
    <div class="bg-gradient-to-r from-slate-900 via-indigo-950/30 to-slate-900 border border-indigo-500/30 rounded-2xl p-6 sm:p-8 mb-12 shadow-xl">
      <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-6">
        <div class="max-w-2xl space-y-3">
          <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
            Observatory Recommendation Engine
          </span>
          <h2 class="text-xl font-bold text-white tracking-tight">
            Why "Recommended" Differs from "Latest"
          </h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Bleeding-edge releases often introduce untested regressions. The Ember Observatory executes an automated telemetry scoring algorithm across all published releases to designate the authoritative <strong>Recommended Release</strong>:
          </p>
          <ul class="text-xs text-slate-400 space-y-2 list-disc list-inside">
            <li><strong class="text-slate-200">Base Score:</strong> Each release starts with 100 points upon initial publication.</li>
            <li><strong class="text-slate-200">GApps &amp; Root Stability (+20 pts):</strong> Awarded to builds providing seamless Play Store and stable root management without crashing system services.</li>
            <li><strong class="text-slate-200">Validation Reports (+10 pts / report):</strong> Earned when package identity, Magisk integrity, and OpenGApps images pass 100% of CI validation checks.</li>
            <li><strong class="text-slate-200">Field Telemetry Protection (-50 pts penalty):</strong> Triggered if user-reported regressions or Play Integrity failures are detected in testing.</li>
          </ul>
        </div>

        <div class="bg-slate-950/80 p-5 rounded-xl border border-slate-800 min-w-[280px]">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Active Policy Decision</h3>
          <div class="space-y-2 text-xs">
            <div>
              <span class="text-slate-500 block text-[10px]">EVALUATOR</span>
              <span class="font-semibold text-white">Ember Observatory</span>
            </div>
            <div>
              <span class="text-slate-500 block text-[10px]">SELECTED RELEASE</span>
              <span class="font-mono text-indigo-400 font-bold">wsa-2311-standard</span>
            </div>
            <div>
              <span class="text-slate-500 block text-[10px]">TOTAL SCORE</span>
              <span class="font-bold text-emerald-400">130 pts (Top Rank)</span>
            </div>
            <div>
              <span class="text-slate-500 block text-[10px]">RATIONALE</span>
              <span class="text-slate-300 leading-relaxed">Evaluated 6 candidates: 100% CTS Play Integrity verification and verified dual-edition packaging.</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Subsystem Channel Statuses -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 mb-12 shadow-xl">
      <h2 class="text-lg font-bold text-white mb-2">Delivery Channel Operations &amp; Status</h2>
      <p class="text-xs text-slate-400 mb-6">
        Operational health and promotion gates across all Emberbird subsystem release channels.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {observatoryChannels.map((ch) => (
          <div class="p-4 rounded-xl bg-slate-950 border border-slate-800">
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-sm font-semibold text-white">{ch.name}</h3>
              <span class={`px-2 py-0.5 rounded text-[10px] font-bold border ${ch.color}`}>
                {ch.status}
              </span>
            </div>
            <p class="text-xs text-slate-400 leading-relaxed">{ch.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Secondary KPI Metrics Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-12">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-sm">
        <div class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Downloads</div>
        <div class="mt-2 text-3xl font-extrabold text-white tracking-tight">
          {formatNumber(releaseMetrics.total_downloads_aggregate)}
        </div>
        <p class="mt-1 text-xs text-slate-500">Across {releaseMetrics.total_releases} production releases</p>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-sm">
        <div class="text-xs font-semibold uppercase tracking-wider text-slate-400">Validated Apps</div>
        <div class="mt-2 text-3xl font-extrabold text-white tracking-tight">
          {compatMetrics.total_apps_tested}
        </div>
        <p class="mt-1 text-xs text-slate-500">{compatMetrics.categories_count} application categories tested</p>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-sm">
        <div class="text-xs font-semibold uppercase tracking-wider text-slate-400">Flavor Diversity</div>
        <div class="mt-2 text-3xl font-extrabold text-indigo-400 tracking-tight font-mono text-2xl">
          Dual Tier-1
        </div>
        <p class="mt-1 text-xs text-slate-500">Magisk Root &bull; Vanilla Banking</p>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-sm">
        <div class="text-xs font-semibold uppercase tracking-wider text-slate-400">Active Build Variants</div>
        <div class="mt-2 text-3xl font-extrabold text-cyan-400 tracking-tight font-mono text-2xl">
          {releaseMetrics.active_packages_count}
        </div>
        <p class="mt-1 text-xs text-slate-500">Standard, Banking, x64, ARM64</p>
      </div>
    </div>

    <!-- Root and Architecture Distribution Grids -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
      <!-- Root Flavor Distribution -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8">
        <h2 class="text-lg font-bold text-white mb-2">Root Solution Distribution</h2>
        <p class="text-xs text-slate-400 mb-6">
          Relative distribution of root management frameworks selected across release downloads.
        </p>

        <div class="space-y-4">
          <div>
            <div class="flex justify-between text-xs font-medium text-slate-300 mb-1.5">
              <span>Magisk (Stable Root)</span>
              <span class="font-mono text-indigo-400">{rootDist.magisk}%</span>
            </div>
            <div class="w-full h-2.5 bg-slate-950 rounded-full overflow-hidden border border-slate-800">
              <div class="h-full bg-indigo-500 rounded-full" style={`width: ${rootDist.magisk}%`} />
            </div>
          </div>

          <div>
            <div class="flex justify-between text-xs font-medium text-slate-300 mb-1.5">
              <span>KernelSU (Kernel-Level Root)</span>
              <span class="font-mono text-purple-400">{rootDist.kernelsu}%</span>
            </div>
            <div class="w-full h-2.5 bg-slate-950 rounded-full overflow-hidden border border-slate-800">
              <div class="h-full bg-purple-500 rounded-full" style={`width: ${rootDist.kernelsu}%`} />
            </div>
          </div>

          <div>
            <div class="flex justify-between text-xs font-medium text-slate-300 mb-1.5">
              <span>No Root (Clean Vanilla)</span>
              <span class="font-mono text-slate-400">{rootDist.none}%</span>
            </div>
            <div class="w-full h-2.5 bg-slate-950 rounded-full overflow-hidden border border-slate-800">
              <div class="h-full bg-slate-600 rounded-full" style={`width: ${rootDist.none}%`} />
            </div>
          </div>
        </div>
      </div>

      <!-- Architecture Distribution -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8">
        <h2 class="text-lg font-bold text-white mb-2">Processor Architecture Mix</h2>
        <p class="text-xs text-slate-400 mb-6">
          Download ratios across Intel/AMD 64-bit and Qualcomm Snapdragon ARM64 devices.
        </p>

        <div class="space-y-4">
          <div>
            <div class="flex justify-between text-xs font-medium text-slate-300 mb-1.5">
              <span>x64 (Intel &amp; AMD Desktop/Laptop)</span>
              <span class="font-mono text-emerald-400">{archDist.x64}%</span>
            </div>
            <div class="w-full h-2.5 bg-slate-950 rounded-full overflow-hidden border border-slate-800">
              <div class="h-full bg-emerald-500 rounded-full" style={`width: ${archDist.x64}%`} />
            </div>
          </div>

          <div>
            <div class="flex justify-between text-xs font-medium text-slate-300 mb-1.5">
              <span>arm64 (Snapdragon X Elite &amp; Surface Pro)</span>
              <span class="font-mono text-cyan-400">{archDist.arm64}%</span>
            </div>
            <div class="w-full h-2.5 bg-slate-950 rounded-full overflow-hidden border border-slate-800">
              <div class="h-full bg-cyan-500 rounded-full" style={`width: ${archDist.arm64}%`} />
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Version Adoption Table -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 mb-12">
      <h2 class="text-lg font-bold text-white mb-2">Subsystem Version Adoption</h2>
      <p class="text-xs text-slate-400 mb-6">
        Distribution of active release versions adopted across the community.
      </p>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-slate-300">
          <thead class="bg-slate-950 text-slate-400 uppercase tracking-wider font-mono text-[10px] border-b border-slate-800">
            <tr>
              <th class="py-3 px-4">Version</th>
              <th class="py-3 px-4">Channel Label</th>
              <th class="py-3 px-4">Release Date</th>
              <th class="py-3 px-4">Share</th>
              <th class="py-3 px-4 text-right">Adoption Bar</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60 font-mono">
            {versionAdoption.map((v) => (
              <tr class="hover:bg-slate-800/30 transition-colors">
                <td class="py-3.5 px-4 font-bold text-white">{v.version}</td>
                <td class="py-3.5 px-4 font-sans text-slate-300">{v.label}</td>
                <td class="py-3.5 px-4 text-slate-400">{v.release_date}</td>
                <td class="py-3.5 px-4 text-indigo-400 font-bold">{v.adoption_percentage}%</td>
                <td class="py-3.5 px-4 text-right w-44">
                  <div class="w-full h-2 bg-slate-950 rounded-full overflow-hidden border border-slate-800">
                    <div class="h-full bg-indigo-500 rounded-full" style={`width: ${v.adoption_percentage}%`} />
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Privacy-First Charter Notice -->
    <div class="bg-gradient-to-r from-slate-900 via-indigo-950/30 to-slate-900 border border-indigo-500/30 rounded-2xl p-6 sm:p-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
        <div class="space-y-2">
          <h3 class="text-base font-bold text-white flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 inline-block" />
            Zero-Telemetry Public Commitment
          </h3>
          <p class="text-xs text-slate-300 max-w-2xl leading-relaxed">
            Our codebase contains no tracking beacons, Google Analytics, cookies, or remote device fingerprinters. All analytics are generated offline through public GitHub API release counters and community-submitted compatibility records.
          </p>
        </div>
        <a
          href="/docs"
          class="px-4 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold whitespace-nowrap shadow-md shadow-indigo-600/20 transition-all text-center"
        >
          View Privacy Specification
        </a>
      </div>
    </div>
  </div>
</Layout>
