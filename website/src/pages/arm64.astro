---
import Layout from '../layouts/Layout.astro';

const hardwareMatrix = [
  {
    chipset: 'Snapdragon X Elite',
    generation: 'X1E-84-100 / X1E-80-100 / X1E-78-100',
    tier: 'Tier 1 (Full Support)',
    devices: 'Surface Pro 11, Surface Laptop 7, Yoga Slim 7x, Dell XPS 13 9345, HP OmniBook X',
    status: 'Verified',
    statusColor: 'text-emerald-400 bg-emerald-500/10 border-emerald-500/20',
    notes: 'Native ARM64-v8a execution, Adreno GPU hardware acceleration via D3D12 passthrough.',
  },
  {
    chipset: 'Snapdragon X Plus',
    generation: 'X1P-64-100 / X1P-42-100',
    tier: 'Tier 1 (Full Support)',
    devices: 'Surface Pro 11 (OLED/LCD), Acer Swift 14 AI, Lenovo IdeaPad 5x',
    status: 'Verified',
    statusColor: 'text-emerald-400 bg-emerald-500/10 border-emerald-500/20',
    notes: 'Same microVM architecture as X Elite, fully supported with 10-core / 8-core configurations.',
  },
  {
    chipset: 'Snapdragon 8cx Gen 3',
    generation: 'SC8280XP',
    tier: 'Tier 2 (Supported)',
    devices: 'Surface Pro 9 with 5G, ThinkPad X13s, Project Volterra (Dev Kit 2023)',
    status: 'Supported',
    statusColor: 'text-cyan-400 bg-cyan-500/10 border-cyan-500/20',
    notes: 'Good performance; hypervisor and nested virtualization fully functional.',
  },
  {
    chipset: 'Snapdragon 8cx Gen 2 / 8cx',
    generation: 'SC8180X',
    tier: 'Legacy Tier (Community)',
    devices: 'Surface Pro X (SQ1 / SQ2), Galaxy Book S, Flex 5G',
    status: 'Legacy',
    statusColor: 'text-amber-400 bg-amber-500/10 border-amber-500/20',
    notes: 'WSA runs but heavy 3D games may experience throttling; 16GB RAM model required.',
  },
];

const abiMatrix = [
  {
    abi: 'arm64-v8a (AArch64)',
    type: 'Native Execution (Zero Overhead)',
    performance: '100% Native Silicon Speed',
    details: 'Executes directly on Qualcomm Oryon / Kryo CPU cores without translation.',
  },
  {
    abi: 'armeabi-v7a (32-bit ARM)',
    type: 'Hardware / OS Thunking',
    performance: 'Near-Native Speed',
    details: 'Handled natively via Android 32-bit runtime libraries inside the microVM.',
  },
  {
    abi: 'x86 / x86_64',
    type: 'Houdini / NDK Translation',
    performance: 'Emulated (~50-70% Native)',
    details: 'Runs via Intel/Google binary bridge for legacy Intel-only APK packages.',
  },
];
---

<Layout
  title="ARM64 & Snapdragon X Elite Guide - Emberbird"
  description="Native Windows Subsystem for Android on Qualcomm Snapdragon X Elite, Copilot+ PCs, and Surface Pro ARM64 devices."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <!-- Hero Header -->
    <div class="max-w-3xl mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 mb-4">
        Qualcomm Snapdragon &bull; Copilot+ PCs &bull; Phase A1
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        ARM64 Subsystem Support Hub
      </h1>
      <p class="mt-4 text-slate-300 leading-relaxed text-sm sm:text-base">
        Experience native Android execution on Qualcomm Snapdragon X Elite, X Plus, and 8cx platforms. With zero instruction translation overhead, Android apps achieve full silicon speed, superior thermal efficiency, and all-day battery life.
      </p>
    </div>

    <!-- Quick Status Highlights -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-12">
      <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 shadow-sm">
        <div class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Native Execution</div>
        <div class="text-2xl font-bold text-white mt-1">Zero Overhead</div>
        <p class="text-xs text-slate-400 mt-1">ARM64-v8a binaries execute directly on Oryon cores without binary translation.</p>
      </div>
      <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 shadow-sm">
        <div class="text-xs uppercase tracking-wider text-slate-400 font-semibold">GPU Acceleration</div>
        <div class="text-2xl font-bold text-emerald-400 mt-1">Adreno D3D12</div>
        <p class="text-xs text-slate-400 mt-1">Hardware-accelerated Vulkan and OpenGL ES passthrough enabled by default.</p>
      </div>
      <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 shadow-sm">
        <div class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Packaging Model</div>
        <div class="text-2xl font-bold text-indigo-400 mt-1">BYOB Pipeline</div>
        <p class="text-xs text-slate-400 mt-1">Bring-Your-Own-Bundle local toolchain packages pristine ARM64 builds in 2 minutes.</p>
      </div>
    </div>

    <!-- Hardware Compatibility Matrix -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 mb-12 shadow-xl">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 border-b border-slate-800 gap-4 mb-6">
        <div>
          <h2 class="text-xl font-bold text-white tracking-tight">Silicon &amp; Hardware Compatibility Matrix</h2>
          <p class="text-xs text-slate-400 mt-1">Verified status for Windows 11 Copilot+ PCs and Qualcomm Snapdragon platforms.</p>
        </div>
        <span class="px-3 py-1 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 text-xs font-semibold self-start sm:self-auto">
          Snapdragon X Verified
        </span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-300">
          <thead class="text-xs uppercase bg-slate-950 text-slate-400 border-b border-slate-800">
            <tr>
              <th class="px-4 py-3">Chipset / Platform</th>
              <th class="px-4 py-3">Tier</th>
              <th class="px-4 py-3">Reference Devices</th>
              <th class="px-4 py-3">Status</th>
              <th class="px-4 py-3">Architectural Notes</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60">
            {hardwareMatrix.map((item) => (
              <tr class="hover:bg-slate-800/40 transition-colors">
                <td class="px-4 py-3.5 font-bold text-white whitespace-nowrap">
                  {item.chipset}
                  <span class="block text-[11px] font-mono font-normal text-slate-400">{item.generation}</span>
                </td>
                <td class="px-4 py-3.5 text-xs text-slate-300 whitespace-nowrap">{item.tier}</td>
                <td class="px-4 py-3.5 text-xs text-slate-400 max-w-xs">{item.devices}</td>
                <td class="px-4 py-3.5 whitespace-nowrap">
                  <span class={`px-2.5 py-0.5 rounded text-xs font-semibold border ${item.statusColor}`}>
                    {item.status}
                  </span>
                </td>
                <td class="px-4 py-3.5 text-xs text-slate-400">{item.notes}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- ABI Breakdown -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 mb-12 shadow-xl">
      <h2 class="text-xl font-bold text-white tracking-tight mb-2">Native ARM ABI Execution Architecture</h2>
      <p class="text-xs text-slate-400 mb-6">
        How Windows Subsystem for Android on Snapdragon processes different Android ABI packages.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {abiMatrix.map((abi) => (
          <div class="p-5 rounded-xl bg-slate-950 border border-slate-800">
            <span class="text-xs font-mono font-bold text-cyan-400 block mb-1">{abi.abi}</span>
            <h3 class="text-sm font-semibold text-white mb-2">{abi.type}</h3>
            <div class="text-xs font-medium text-emerald-400 mb-2">{abi.performance}</div>
            <p class="text-xs text-slate-400 leading-relaxed">{abi.details}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Step-by-Step BYOB Local Build Guide -->
    <div class="bg-gradient-to-r from-slate-900 via-indigo-950/20 to-slate-900 border border-indigo-500/20 rounded-2xl p-6 sm:p-8 mb-12 shadow-xl">
      <div class="mb-8">
        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
          Assembly Guide
        </span>
        <h2 class="text-2xl font-bold text-white tracking-tight mt-3">
          Bring-Your-Own-Bundle (BYOB) Build Instructions for ARM64
        </h2>
        <p class="text-xs sm:text-sm text-slate-300 mt-2 leading-relaxed">
          Due to Microsoft archive redistribution limits, ARM64 packages are built locally on your machine using the automated Emberbird standalone toolchain (<code class="text-indigo-300 font-mono">tools/build_local.py</code>). This generates an installable unpackaged distribution in under 3 minutes.
        </p>
      </div>

      <div class="space-y-6">
        <!-- Step 1 -->
        <div class="bg-slate-950/80 rounded-xl p-5 border border-slate-800">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-6 h-6 rounded-full bg-indigo-600 text-white font-bold text-xs flex items-center justify-center">1</span>
            <h3 class="text-sm font-bold text-white">Enable Host Virtualization Features (PowerShell Admin)</h3>
          </div>
          <p class="text-xs text-slate-400 mb-3 ml-9">
            Verify that your Snapdragon device has the Virtual Machine Platform and Hyper-V features enabled:
          </p>
          <div class="ml-9 bg-slate-900 p-3 rounded-lg border border-slate-800 font-mono text-xs text-slate-300 flex items-center justify-between">
            <code class="select-all">dism.exe /online /enable-feature /featurename:VirtualMachinePlatform /all /norestart</code>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="bg-slate-950/80 rounded-xl p-5 border border-slate-800">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-6 h-6 rounded-full bg-indigo-600 text-white font-bold text-xs flex items-center justify-center">2</span>
            <h3 class="text-sm font-bold text-white">Acquire the Official Microsoft WSA MSIXBundle</h3>
          </div>
          <p class="text-xs text-slate-400 mb-3 ml-9">
            Download the official Microsoft WSA bundle (e.g. <code class="text-slate-300">MicrosoftCorporationII.WindowsSubsystemForAndroid_2407.40000.4.0_neutral_~_8wekyb3d8bbwe.msixbundle</code>) from the Microsoft Store portal or your internal archive.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="bg-slate-950/80 rounded-xl p-5 border border-slate-800">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-6 h-6 rounded-full bg-indigo-600 text-white font-bold text-xs flex items-center justify-center">3</span>
            <h3 class="text-sm font-bold text-white">Run the Native ARM64 Builder</h3>
          </div>
          <p class="text-xs text-slate-400 mb-3 ml-9">
            Execute <code class="text-indigo-300">tools/build_local.py</code> specifying the target architecture as <code class="text-cyan-300 font-mono">arm64</code>:
          </p>
          <div class="ml-9 space-y-2">
            <div>
              <span class="text-[11px] text-slate-400 block mb-1">Standard Edition (Magisk Stable Root + OpenGApps Pico):</span>
              <div class="bg-slate-900 p-3 rounded-lg border border-slate-800 font-mono text-xs text-indigo-300 flex items-center justify-between">
                <code class="select-all">python tools/build_local.py --arch arm64 --wsa-file "C:\Path\To\wsa.msixbundle"</code>
              </div>
            </div>
            <div>
              <span class="text-[11px] text-slate-400 block mb-1">Banking Edition (Vanilla / No Root + OpenGApps Pico):</span>
              <div class="bg-slate-900 p-3 rounded-lg border border-slate-800 font-mono text-xs text-emerald-300 flex items-center justify-between">
                <code class="select-all">python tools/build_local.py --arch arm64 --root-sol none --wsa-file "C:\Path\To\wsa.msixbundle"</code>
              </div>
            </div>
          </div>
        </div>

        <!-- Step 4 -->
        <div class="bg-slate-950/80 rounded-xl p-5 border border-slate-800">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-6 h-6 rounded-full bg-indigo-600 text-white font-bold text-xs flex items-center justify-center">4</span>
            <h3 class="text-sm font-bold text-white">Install the Subsystem into Windows 11 ARM64</h3>
          </div>
          <p class="text-xs text-slate-400 mb-3 ml-9">
            Open an elevated PowerShell window inside the generated <code class="text-slate-300 font-mono">output/WSA_..._arm64</code> folder and register the package:
          </p>
          <div class="ml-9 bg-slate-900 p-3 rounded-lg border border-slate-800 font-mono text-xs text-slate-300 flex items-center justify-between">
            <code class="select-all">.\Install.ps1</code>
          </div>
        </div>
      </div>
    </div>

    <!-- Diagnostic & Help Links -->
    <div class="flex flex-wrap items-center justify-between gap-4 p-5 rounded-2xl bg-slate-900/60 border border-slate-800">
      <div>
        <h4 class="text-sm font-bold text-white">Experiencing issues on your Snapdragon device?</h4>
        <p class="text-xs text-slate-400 mt-0.5">Run Ember Doctor to inspect virtualization and Hyper-V status on ARM64.</p>
      </div>
      <div class="flex items-center gap-3">
        <a
          href="/troubleshoot/doctor"
          class="px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold transition-colors"
        >
          Open Ember Doctor
        </a>
        <a
          href="/downloads"
          class="px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold transition-colors border border-slate-700"
        >
          View All Downloads
        </a>
      </div>
    </div>
  </div>
</Layout>
