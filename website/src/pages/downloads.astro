---
import Layout from '../layouts/Layout.astro';
const releasesUrl = import.meta.env.PUBLIC_RELEASES_URL;
if (!releasesUrl) {
  throw new Error('Configuration error: PUBLIC_RELEASES_URL environment variable is required.');
}
---

<Layout title="Download Windows Subsystem for Android - WSABuilds">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        Download WSA Packages
      </h1>
      <p class="mt-4 text-slate-400">
        Choose your desired architecture, root flavor, and Google Apps integration. All packages are built with linear commit provenance.
      </p>
    </div>

    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-xl">
      <h2 class="text-xl font-bold text-white mb-6">Package Selection Matrix</h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
            1. Architecture
          </label>
          <select id="select-arch" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-4 py-2.5 text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none">
            <option value="x64" selected>x64 (Intel / AMD 64-bit)</option>
            <option value="arm64">arm64 (Snapdragon / ARM64)</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
            2. Root Solution
          </label>
          <select id="select-root" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-4 py-2.5 text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none">
            <option value="Magisk" selected>Magisk Stable</option>
            <option value="KernelSU">KernelSU</option>
            <option value="NoRoot">No Root (Vanilla)</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
            3. Google Services
          </label>
          <select id="select-gapps" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-4 py-2.5 text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none">
            <option value="GApps-Pico" selected>Google Play Store (GApps Pico)</option>
            <option value="NoGApps">No GApps (AOSP Only)</option>
          </select>
        </div>
      </div>

      <div class="p-4 rounded-lg bg-slate-950 border border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <div class="text-xs text-slate-500 uppercase font-semibold">Selected Flavor Target</div>
          <div id="target-flavor-display" class="text-sm font-mono text-indigo-400 mt-0.5">
            WSA_[version]_x64_Magisk_GApps-Pico.7z
          </div>
        </div>

        <a
          id="download-cta"
          href={releasesUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-6 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-center transition-colors"
        >
          View Release on GitHub
        </a>
      </div>
    </div>

    <div class="mt-12 bg-slate-900/50 border border-slate-800/80 rounded-xl p-6">
      <h3 class="text-base font-semibold text-white mb-2">Package Verification & Checksums</h3>
      <p class="text-xs text-slate-400 leading-relaxed">
        Every official package release is published alongside a matching SHA-256 checksum digest. Before running <code class="text-indigo-400">Install.ps1</code>, verify archive integrity via Windows PowerShell:
      </p>
      <pre class="mt-3 p-3 bg-slate-950 rounded-lg text-xs font-mono text-slate-300 overflow-x-auto border border-slate-800">Get-FileHash -Algorithm SHA256 -Path ".\WSA_[version]_x64.7z"</pre>
    </div>
  </div>

  <script>
    function updateDisplay() {
      const arch = (document.getElementById('select-arch') as HTMLSelectElement)?.value || 'x64';
      const root = (document.getElementById('select-root') as HTMLSelectElement)?.value || 'Magisk';
      const gapps = (document.getElementById('select-gapps') as HTMLSelectElement)?.value || 'GApps-Pico';
      const display = document.getElementById('target-flavor-display');
      if (display) {
        display.textContent = `WSA_[version]_${arch}_${root}_${gapps}.7z`;
      }
    }

    document.getElementById('select-arch')?.addEventListener('change', updateDisplay);
    document.getElementById('select-root')?.addEventListener('change', updateDisplay);
    document.getElementById('select-gapps')?.addEventListener('change', updateDisplay);
  </script>
</Layout>
