---
import Layout from '../layouts/Layout.astro';
import IntegrityModal from '../components/IntegrityModal.astro';
import { pinnedReleaseService } from '../lib/release-service';
import versionData from '../../../deployment/version.json';

const releasesUrl = import.meta.env.PUBLIC_RELEASES_URL;
if (!releasesUrl) {
  throw new Error('Configuration error: PUBLIC_RELEASES_URL environment variable is required.');
}

const [managerRelease, wsaRelease] = await Promise.all([
  pinnedReleaseService.getLatestForChannel('manager'),
  pinnedReleaseService.getLatestForChannel('wsa')
]);
const managerAssets = managerRelease?.assets || [];
const wsaAssets = wsaRelease?.assets || [];
const managerMeta = versionData.manager;
const wsaBaseline = versionData.subsystem_baseline;
const wingetInstallCmd = `winget install ${managerMeta.winget_package_id}`;
---

<Layout title="Download Windows Subsystem for Android - WSABuilds">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="max-w-3xl mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 mb-4">
        Verified Release Builds
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        Available Releases &amp; Packages
      </h1>
      <p class="mt-4 text-slate-400 leading-relaxed">
        Download verified pre-configured Windows Subsystem for Android packages and the WSABuilds Manager. Every asset below is pinned to a specific release tag and checksum-published.
      </p>
    </div>

    <!-- WSABuilds Manager & Winget Distribution Card -->
    <div class="bg-gradient-to-r from-slate-900 via-indigo-950/40 to-slate-900 border border-indigo-500/30 rounded-2xl p-6 sm:p-8 mb-10 shadow-xl shadow-indigo-950/20">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div class="space-y-2 max-w-xl">
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full bg-indigo-500/20 border border-indigo-500/30 text-indigo-300 text-xs font-semibold">
              Official Desktop Manager
            </span>
            <span class="px-2.5 py-0.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-semibold">
              Preview • Manifest In Review
            </span>
            <span class="text-xs text-slate-400 font-mono">v{managerMeta.version}</span>
          </div>
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
            WSABuilds Manager Desktop Client
          </h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Native lifecycle manager for Windows Subsystem for Android with verified cold VHDX snapshots, container restoration with rollback safety, and automated upgrade coordination.
          </p>
          <div class="flex flex-wrap items-center gap-3 pt-1 text-xs text-slate-400">
            <span>Package: <strong class="text-slate-200 font-mono">{managerMeta.winget_package_id}</strong></span>
            <span>•</span>
            <span>OS: <strong class="text-slate-200">Windows 10/11 ({managerMeta.target_architectures.join(', ')})</strong></span>
            <span>•</span>
            <span>License: <strong class="text-slate-200">{managerMeta.license}</strong></span>
          </div>
        </div>

        <div class="flex flex-col gap-3 min-w-[280px]">
          <div>
            <span class="block text-[11px] font-semibold text-slate-400 uppercase tracking-wider mb-1.5">
              Install via Windows Package Manager (In Review)
            </span>
            <div class="flex items-center gap-2 bg-slate-950 border border-slate-700/80 rounded-lg p-2 font-mono text-xs text-indigo-300">
              <span class="text-slate-500 select-none">&gt;</span>
              <code id="winget-cmd" class="flex-1 truncate">{wingetInstallCmd}</code>
              <button
                type="button"
                id="copy-winget-btn"
                class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs transition-colors border border-slate-700 whitespace-nowrap"
                title="Copy install command"
              >
                Copy
              </button>
            </div>
          </div>

          <div class="flex items-center gap-2 pt-1">
            <a
              href={`${releasesUrl}/tag/v${managerMeta.version}`}
              class="flex-1 text-center px-3 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold shadow-md shadow-indigo-600/20 transition-all"
            >
              Direct Installer (.exe)
            </a>
            <a
              href={`${releasesUrl}/tag/v${managerMeta.version}`}
              class="flex-1 text-center px-3 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 text-xs font-semibold transition-all"
            >
              Portable (.zip)
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Tier 1 Multi-Configuration Editions Showcase -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
      <div class="bg-slate-900 border border-indigo-500/30 rounded-xl p-6 relative overflow-hidden">
        <div class="flex items-center justify-between mb-3">
          <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
            Tier 1 • Primary Edition
          </span>
          <span class="text-xs text-slate-400 font-mono">x64</span>
        </div>
        <h3 class="text-lg font-bold text-white mb-2">Standard Edition (Magisk + Pico)</h3>
        <p class="text-xs text-slate-300 leading-relaxed mb-4">
          Pre-rooted with official Magisk Stable (v30.6+) and OpenGApps Pico. Recommended for developers, modders, and power users who require root privilege management (UID 0 shell access).
        </p>
        <ul class="text-xs text-slate-400 space-y-1.5 list-disc list-inside">
          <li>Full Magisk root daemon with automated ADB authorization</li>
          <li>Google Play Store and Google Play Services (Pico)</li>
          <li>Pixel 5 device fingerprint spoofing for Play Protect</li>
        </ul>
      </div>

      <div class="bg-slate-900 border border-emerald-500/30 rounded-xl p-6 relative overflow-hidden">
        <div class="flex items-center justify-between mb-3">
          <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
            Tier 1 • Enterprise &amp; Banking
          </span>
          <span class="text-xs text-slate-400 font-mono">x64</span>
        </div>
        <h3 class="text-lg font-bold text-white mb-2">Banking Edition (Vanilla + Pico)</h3>
        <p class="text-xs text-slate-300 leading-relaxed mb-4">
          Unrooted early-boot ramdisk with OpenGApps Pico. Built for users running financial, banking, government, and enterprise apps that strictly enforce root detection and Play Integrity.
        </p>
        <ul class="text-xs text-slate-400 space-y-1.5 list-disc list-inside">
          <li>100% clean ramdisk: zero Magisk binaries, su daemons, or scripts</li>
          <li>Full Google Play Store and Google Play Services (Pico)</li>
          <li>Ideal for banking apps, OTT streaming, and corporate MDM</li>
        </ul>
      </div>
    </div>

    <!-- WSA Package Table (Tier 1 x64 editions) -->
    {wsaRelease ? (
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 mb-10">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800 pb-6 mb-6">
          <div>
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Current WSA Build Version</div>
            <div class="text-2xl font-bold text-white mt-1 flex items-center gap-3">
              <span>{wsaRelease.tag}</span>
              <span class="text-xs px-2.5 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300 font-normal">
                {wsaAssets.length} packages
              </span>
            </div>
            <div class="text-xs text-slate-500 mt-1 font-mono">
              WSA baseline {wsaBaseline.wsa_version} · Android {wsaBaseline.android_version}
            </div>
          </div>
          <div class="text-right sm:text-right">
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Published Date</div>
            <div class="text-sm font-medium text-slate-300 mt-1">{wsaRelease.formattedDate}</div>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm text-slate-300">
            <thead class="text-xs uppercase bg-slate-950 text-slate-400 border-b border-slate-800">
              <tr>
                <th class="px-4 py-3">Package Asset</th>
                <th class="px-4 py-3">Edition</th>
                <th class="px-4 py-3">Arch</th>
                <th class="px-4 py-3">GApps</th>
                <th class="px-4 py-3">Size</th>
                <th class="px-4 py-3 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/60">
              {wsaAssets.map((asset) => (
                <tr class="hover:bg-slate-800/40 transition-colors">
                  <td class="px-4 py-3.5 font-mono text-xs text-white max-w-xs truncate">
                    {asset.fileName}
                  </td>
                  <td class="px-4 py-3.5">
                    <span class:list={['px-2 py-0.5 rounded text-xs font-medium',
                      asset.rootFlavor === 'Magisk'
                        ? 'bg-indigo-500/20 text-indigo-300'
                        : 'bg-emerald-500/20 text-emerald-300']}>
                      {asset.rootFlavor === 'Magisk' ? 'Standard (Rooted)' : 'Banking (No Root)'}
                    </span>
                  </td>
                  <td class="px-4 py-3.5">
                    <span class="px-2 py-0.5 rounded text-xs font-medium bg-slate-800 text-slate-300">
                      {asset.architecture}
                    </span>
                  </td>
                  <td class="px-4 py-3.5">
                    <span class="px-2 py-0.5 rounded text-xs font-medium bg-emerald-500/20 text-emerald-300">
                      {asset.gappsFlavor}
                    </span>
                    <span class="ml-1 text-[10px] text-slate-500">+ Play Store</span>
                  </td>
                  <td class="px-4 py-3.5 text-xs text-slate-400">
                    {asset.formattedSize}
                  </td>
                  <td class="px-4 py-3.5 text-right space-x-2">
                    <button
                      type="button"
                      onclick={`window.openIntegrityModal('${asset.fileName}', '${asset.sha256 || ''}')`}
                      class="px-2.5 py-1 text-xs rounded bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors"
                    >
                      Checksum
                    </button>
                    <a
                      href={asset.downloadUrl}
                      class="inline-block px-3 py-1 text-xs font-semibold rounded bg-indigo-600 hover:bg-indigo-500 text-white transition-colors"
                    >
                      Download
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="mt-4 text-xs text-slate-500">
          SHA-256 checksums for both editions are published in
          <a href={`${releasesUrl}/download/${wsaRelease.tag}/checksums.txt`} class="text-indigo-400 hover:text-indigo-300 underline">checksums.txt</a>
          on the same release. Full validation reports (package identity, integrity, Magisk &amp; GApps) ship alongside every build.
        </div>
      </div>
    ) : (
      <div class="bg-slate-900 border border-amber-500/30 rounded-2xl p-10 text-center mb-10">
        <h3 class="text-lg font-bold text-white mb-2">WSA Package Feed Unavailable</h3>
        <p class="text-sm text-slate-400 max-w-xl mx-auto mb-6">
          The WSA release feed could not be resolved right now. Access the current Tier 1 builds directly on the GitHub Releases portal.
        </p>
        <a
          href={`${releasesUrl}/tag/${wsaBaseline.release_tag}`}
          class="px-6 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-semibold transition-colors"
        >
          Open WSA Release ({wsaBaseline.release_tag})
        </a>
      </div>
    )}

    <!-- Manager Package Table -->
    {managerRelease ? (
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 mb-10">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800 pb-6 mb-6">
          <div>
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Current Manager Version</div>
            <div class="text-2xl font-bold text-white mt-1 flex items-center gap-3">
              <span>{managerRelease.tag}</span>
              <span class="text-xs px-2.5 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300 font-normal">
                {managerAssets.length} packages
              </span>
            </div>
          </div>
          <div class="text-right sm:text-right">
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Published Date</div>
            <div class="text-sm font-medium text-slate-300 mt-1">{managerRelease.formattedDate}</div>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm text-slate-300">
            <thead class="text-xs uppercase bg-slate-950 text-slate-400 border-b border-slate-800">
              <tr>
                <th class="px-4 py-3">Package Asset</th>
                <th class="px-4 py-3">Type</th>
                <th class="px-4 py-3">Arch</th>
                <th class="px-4 py-3">Size</th>
                <th class="px-4 py-3 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/60">
              {managerAssets.map((asset) => (
                <tr class="hover:bg-slate-800/40 transition-colors">
                  <td class="px-4 py-3.5 font-mono text-xs text-white max-w-xs truncate">
                    {asset.fileName}
                  </td>
                  <td class="px-4 py-3.5">
                    <span class="px-2 py-0.5 rounded text-xs font-medium bg-indigo-500/20 text-indigo-300">
                      {asset.fileName.endsWith('.exe') ? 'Installer (NSIS)' : 'Portable (ZIP)'}
                    </span>
                  </td>
                  <td class="px-4 py-3.5">
                    <span class="px-2 py-0.5 rounded text-xs font-medium bg-slate-800 text-slate-300">
                      {asset.architecture}
                    </span>
                  </td>
                  <td class="px-4 py-3.5 text-xs text-slate-400">
                    {asset.formattedSize}
                  </td>
                  <td class="px-4 py-3.5 text-right space-x-2">
                    <button
                      type="button"
                      onclick={`window.openIntegrityModal('${asset.fileName}', '${asset.sha256 || ''}')`}
                      class="px-2.5 py-1 text-xs rounded bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors"
                    >
                      Checksum
                    </button>
                    <a
                      href={asset.downloadUrl}
                      class="inline-block px-3 py-1 text-xs font-semibold rounded bg-indigo-600 hover:bg-indigo-500 text-white transition-colors"
                    >
                      Download
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="mt-4 text-xs text-slate-500">
          Per-asset SHA-256 sidecars (<span class="font-mono">.sha256</span>) and a combined
          <a href={`${releasesUrl}/download/v${managerMeta.version}/WSABuildsManager-${managerMeta.version}-checksums.txt`} class="text-indigo-400 hover:text-indigo-300 underline">checksums.txt</a>
          are published with every Manager release.
        </div>
      </div>
    ) : (
      <div class="bg-slate-900 border border-amber-500/30 rounded-2xl p-10 text-center mb-10">
        <h3 class="text-lg font-bold text-white mb-2">Manager Package Feed Unavailable</h3>
        <p class="text-sm text-slate-400 max-w-xl mx-auto mb-6">
          The Manager release feed could not be resolved right now. Access the current build directly on the GitHub Releases portal.
        </p>
        <a
          href={`${releasesUrl}/tag/v${managerMeta.version}`}
          class="px-6 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-semibold transition-colors"
        >
          Open Manager Release (v{managerMeta.version})
        </a>
      </div>
    )}

    <!-- ARM64 Tier-2 Redirect Card -->
    <div class="bg-slate-900 border border-slate-700/60 border-dashed rounded-2xl p-6 sm:p-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="max-w-xl">
          <div class="flex items-center gap-2 mb-2">
            <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-800 text-slate-300 border border-slate-600">
              Tier 2 • On-Demand
            </span>
            <span class="text-xs text-slate-400 font-mono">arm64</span>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">ARM64 (Snapdragon) Builds</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Native Qualcomm Snapdragon packages are produced on demand rather than on every release cycle. If your PC runs a native ARM processor (e.g. Surface Pro X / Pro 11), check the releases portal for the latest ARM64 build.
          </p>
        </div>
        <a
          href={releasesUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 px-5 py-2.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-600 text-white text-sm font-semibold transition-colors"
        >
          View All Releases
        </a>
      </div>
    </div>

    <div class="mt-8 text-center text-xs text-slate-500">
      Checksums are computed during CI build stages and verified before deployment.
    </div>
  </div>

  <IntegrityModal />

  <script>
    const copyBtn = document.getElementById('copy-winget-btn');
    const wingetCmd = document.getElementById('winget-cmd');
    copyBtn?.addEventListener('click', async () => {
      if (wingetCmd?.textContent) {
        try {
          await navigator.clipboard.writeText(wingetCmd.textContent);
          const originalText = copyBtn.textContent;
          copyBtn.textContent = 'Copied!';
          copyBtn.classList.add('text-emerald-400');
          setTimeout(() => {
            copyBtn.textContent = originalText;
            copyBtn.classList.remove('text-emerald-400');
          }, 2000);
        } catch {
          // Clipboard fallback
        }
      }
    });
  </script>
</Layout>
