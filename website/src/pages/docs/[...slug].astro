---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={`${entry.data.title} - WSABuilds Documentation`}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="mb-8">
      <a href="/docs" class="text-xs font-semibold text-indigo-400 hover:text-indigo-300 uppercase tracking-wider">
        <- Back to Documentation Index
      </a>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mt-3">
        {entry.data.title}
      </h1>
      <p class="text-sm text-slate-400 mt-2">{entry.data.description}</p>
    </div>

    <article class="prose prose-invert prose-indigo max-w-none prose-headings:font-bold prose-a:text-indigo-400">
      <Content />
    </article>
  </div>
</Layout>
